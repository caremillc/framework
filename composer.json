{
    "name": "caremillc/framework",
    "description": "The Flint PHP framework.",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": "~8.4.0 || ~8.5.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^12.5"
    },
    "autoload": {
        "psr-4": {
            "Flint\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Flint\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "@php vendor/bin/phpunit --configuration=phpunit.xml"
    },
    "config": {
        "sort-packages": true
    }
}