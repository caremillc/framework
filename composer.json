{
    "name": "caremillc/framework",
    "description": "The Flint PHP framework.",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": "~8.2.0 || ~8.4.0 || ~8.5.0",
        "psr/container": "^2.0",
        "vlucas/phpdotenv": "^5.6"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.95",
        "phpstan/phpstan": "^2.1",
        "phpunit/phpunit": "^12.5"
    },
    "autoload": {
        "psr-4": {
            "Flint\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Flint\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "validate:package": "@composer validate --strict",
        "autoload:check": "@composer dump-autoload --optimize --strict-psr --strict-ambiguous",
        "platform:check": "@composer check-platform-reqs",
        "lint": "@php bin/lint.php",
        "cs:check": "@php vendor/bin/php-cs-fixer fix --config=.php-cs-fixer.dist.php --dry-run --diff",
        "cs:fix": "@php vendor/bin/php-cs-fixer fix --config=.php-cs-fixer.dist.php",
        "analyse": "@php vendor/bin/phpstan analyse --configuration=phpstan.neon.dist --no-progress --memory-limit=512M",
        "test": "@php vendor/bin/phpunit --configuration=phpunit.xml",
        "check": [
            "@validate:package",
            "@autoload:check",
            "@platform:check",
            "@lint",
            "@cs:check",
            "@analyse",
            "@test"
        ]
    },
    "config": {
        "sort-packages": true,
        "platform": {
            "php": "8.4.0"
        }
    }
}
