{
  "name": "caremillc/framework",
  "description": "A modular, testable, enterprise-oriented PHP application framework.",
  "type": "library",
  "license": "MIT",
  "keywords": [
    "careminate",
    "enterprise",
    "framework",
    "php"
  ],
  "require": {
    "php": "^8.2"
  },
  "require-dev": {
    "friendsofphp/php-cs-fixer": "^3.64",
    "phpstan/phpstan": "^2.1",
    "phpstan/phpstan-phpunit": "^2.0",
    "phpunit/phpunit": "^11.5",
    "rector/rector": "^2.1"
  },
  "autoload": {
    "psr-4": {
      "Careminate\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Careminate\\Tests\\": "tests/"
    }
  },
  "scripts": {
    "test": "@php vendor/bin/phpunit --configuration phpunit.xml.dist",
    "analyse": "@php vendor/bin/phpstan analyse --configuration=phpstan.neon.dist --memory-limit=1G",
    "cs:check": "@php vendor/bin/php-cs-fixer fix --config=.php-cs-fixer.dist.php --dry-run --diff --verbose",
    "cs:fix": "@php vendor/bin/php-cs-fixer fix --config=.php-cs-fixer.dist.php --verbose",
    "refactor:check": "@php vendor/bin/rector process --config=rector.php --dry-run",
    "refactor": "@php vendor/bin/rector process --config=rector.php",
    "quality": [
      "@test",
      "@analyse",
      "@cs:check",
      "@refactor:check"
    ]
  },
  "config": {
    "allow-plugins": false,
    "optimize-autoloader": true,
    "platform-check": true,
    "sort-packages": true
  },
  "extra": {
    "branch-alias": {
      "dev-main": "0.1.x-dev"
    }
  }
}
