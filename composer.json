{
    "name": "caremillc/framework",
    "description": "Careminate PHP Framework",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": "^8.4",
        "psr/container": "^2.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^12.0",
        "phpstan/phpstan": "^2.0",
        "friendsofphp/php-cs-fixer": "^3.0"
    },
    "autoload": {
        "psr-4": {
            "Careminate\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Careminate\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "smoke": "@php tests/smoke.php",
        "test": "@php vendor/bin/phpunit --configuration=phpunit.xml",
        "analyse": "@php vendor/bin/phpstan analyse --configuration=phpstan.neon --no-progress",
        "cs:check": "@php vendor/bin/php-cs-fixer fix --config=.php-cs-fixer.dist.php --dry-run --diff --allow-unsupported-php-version=yes",
        "cs:fix": "@php vendor/bin/php-cs-fixer fix --config=.php-cs-fixer.dist.php --allow-unsupported-php-version=yes",
        "lint": [
            "@php -l src/Foundation/Framework.php",
            "@php -l src/Container/Container.php",
            "@php -l src/Container/Exception/ContainerException.php",
            "@php -l src/Container/Exception/NotFoundException.php",
            "@php -l tests/smoke.php",
            "@php -l tests/Unit/Foundation/FrameworkTest.php",
            "@php -l tests/Unit/Container/ContainerTest.php",
            "@php -l tests/Unit/Container/AliasContainerTest.php",
            "@php -l tests/Unit/Container/PsrContainerTest.php",
            "@php -l tests/Unit/Container/AutowiringTest.php",
            "@php -l tests/Unit/Container/AutowiringEdgeCaseTest.php",
            "@php -l src/Foundation/Application.php",
            "@php -l tests/Unit/Foundation/ApplicationTest.php",
            "@php -l src/Config/Environment.php",
            "@php -l src/Config/Configuration.php",
            "@php -l tests/Unit/Config/EnvironmentTest.php",
            "@php -l tests/Unit/Config/ConfigurationTest.php",
            "@php -l src/Config/ConfigurationLoader.php",
            "@php -l src/Config/ConfigurationValidator.php",
            "@php -l tests/Unit/Config/ConfigurationLoaderTest.php",
            "@php -l tests/Unit/Config/ConfigurationValidatorTest.php",
            "@php -l tests/Unit/Config/ConfigurationIntegrationTest.php",
            "@php -l src/Logging/LogLevel.php",
            "@php -l src/Logging/JsonLogger.php",
            "@php -l tests/Unit/Logging/JsonLoggerTest.php",
            "@php -l src/Logging/LogLevel.php",
            "@php -l src/Logging/JsonLogger.php",
            "@php -l src/Logging/CorrelationId.php",
            "@php -l src/Logging/ExceptionReport.php",
            "@php -l src/Logging/ExceptionReporter.php",
            "@php -l tests/Unit/Logging/JsonLoggerTest.php",
            "@php -l tests/Unit/Logging/ExceptionReporterTest.php",
            "@php -l src/Foundation/Application.php",
            "@php -l tests/Unit/Foundation/ApplicationExceptionReportingTest.php",
            "@php -l tests/Unit/Logging/JsonLoggerHardeningTest.php",
            "@php -l src/Http/Request.php",
            "@php -l src/Http/Response.php",
            "@php -l tests/Unit/Http/RequestTest.php",
            "@php -l tests/Unit/Http/ResponseTest.php",
            "@php -l src/Http/Routing/Route.php",
            "@php -l src/Http/Routing/Router.php",
            "@php -l tests/Unit/Http/Routing/RouteTest.php",
            "@php -l tests/Unit/Http/Routing/RouterTest.php",
            "@php -l src/Http/Middleware/Middleware.php",
            "@php -l src/Http/Middleware/Pipeline.php",
            "@php -l tests/Unit/Http/Middleware/PipelineTest.php",
            "@php -l src/Http/Exception/HttpException.php",
            "@php -l src/Http/Middleware/ExceptionHandler.php",
            "@php -l tests/Unit/Http/Exception/HttpExceptionTest.php",
            "@php -l tests/Unit/Http/Middleware/ExceptionHandlerTest.php",
            "@php -l tests/Unit/Http/ResponseHardeningTest.php",
            "@php -l src/Http/Kernel.php",
            "@php -l tests/Unit/Http/KernelTest.php",
            "@php -l tests/Unit/Http/Routing/RouterFreezeTest.php",
            "@php -l tests/Unit/Http/KernelFreezeTest.php",
            "@php -l tests/Unit/Http/Middleware/PipelineFreezeTest.php",
            "@php -l tests/Unit/Http/KernelPipelineFreezeTest.php",
            "@php -l tests/Unit/Http/KernelLifecycleTest.php",
            "@php -l src/Http/ServerRequestFactory.php",
            "@php -l tests/Unit/Http/ServerRequestFactoryTest.php",
            "@php -l src/Http/Emission/ResponseOutput.php",
            "@php -l src/Http/Emission/NativeResponseOutput.php",
            "@php -l src/Http/Emission/BufferedResponseOutput.php",
            "@php -l src/Http/Emission/ResponseEmitter.php",
            "@php -l tests/Unit/Http/Emission/ResponseEmitterTest.php",
            "@php -l src/Http/Runtime/HttpRunner.php",
            "@php -l tests/Unit/Http/Runtime/HttpRunnerTest.php",
            "@php -l tests/Unit/Http/Runtime/HttpRuntimeHardeningTest.php",
            "@php -l examples/frontend-demo/bootstrap.php",
            "@php -l examples/frontend-demo/public/index.php",
            "@php -l examples/frontend-demo/public/router.php",
            "@php -l tests/Integration/FrontendControllerTest.php",
            "@php -l tests/Integration/FrontendHttpServerTest.php"
        ],
        "check": [
            "composer validate --strict",
            "@lint",
            "@cs:check",
            "@analyse",
            "@test",
            "@smoke"
        ]
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}