{
    "name": "caremillc/framework",
    "description": "Careminate PHP Framework",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": "^8.4"
    },
    "require-dev": {
        "phpunit/phpunit": "^12.0",
        "phpstan/phpstan": "^2.0",
        "friendsofphp/php-cs-fixer": "^3.0"
    },
    "autoload": {
        "psr-4": {
            "Careminate\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Careminate\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "smoke": "@php tests/smoke.php",
        "test": "@php vendor/bin/phpunit --configuration=phpunit.xml",
        "analyse": "@php vendor/bin/phpstan analyse --configuration=phpstan.neon --no-progress",
        "cs:check": "@php vendor/bin/php-cs-fixer fix --config=.php-cs-fixer.dist.php --dry-run --diff --allow-unsupported-php-version=yes",
        "cs:fix": "@php vendor/bin/php-cs-fixer fix --config=.php-cs-fixer.dist.php --allow-unsupported-php-version=yes",
        "lint": [
            "@php -l src/Foundation/Framework.php",
            "@php -l tests/Unit/Foundation/FrameworkTest.php"
        ],
        "check": [
            "composer validate --strict",
            "@lint",
            "@cs:check",
            "@analyse",
            "@test",
            "@smoke"
        ]
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}