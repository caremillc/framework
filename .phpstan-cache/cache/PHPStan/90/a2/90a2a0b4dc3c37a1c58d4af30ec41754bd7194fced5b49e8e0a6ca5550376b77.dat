 * (PHP 5 &gt;= 5.1.0, PHP 7, PECL pdo_sqlite &gt;= 1.0.0)<br/>
 * Registers an aggregating User Defined Function for use in SQL statements
 * @link https://php.net/manual/en/pdo.sqlitecreateaggregate.php
 * @param string $function_name <p>
 * The name of the function used in SQL statements.
 * </p>
 * @param callable $step_func <p>
 * Callback function called for each row of the result set. Your PHP function should accumulate the result and store it in the aggregation context.
 * </p>
 * @param callable $finalize_func <p>
 * Callback function to aggregate the "stepped" data from each row. Once all the rows have been processed, this function will be called and it should then take the data from the aggregation context and return the result. This callback function should return a type understood by SQLite (i.e. scalar type).
 * </p>
 * @param int $num_args [optional] <p>
 * Hint to the SQLite parser if the callback function accepts a predetermined number of arguments.
 * </p>
 * @return bool <b>TRUE</b> on success or <b>FALSE</b> on failure.
 * @deprecated
 */";s:9:"startLine";i:1313;s:7:"endLine";i:1316;s:11:"startColumn";i:9;s:9:"endColumn";i:9;s:10:"couldThrow";b:0;s:9:"isClosure";b:0;s:11:"isGenerator";b:0;s:10:"isVariadic";b:0;s:9:"modifiers";i:1;s:9:"namespace";N;s:18:"declaringClassName";s:3:"PDO";s:21:"implementingClassName";s:3:"PDO";s:16:"currentClassName";s:3:"PDO";s:9:"aliasName";N;}s:21:"sqliteCreateCollation";a:20:{s:4:"name";s:21:"sqliteCreateCollation";s:10:"parameters";a:2:{s:4:"name";a:14:{s:4:"name";s:4:"name";s:7:"default";N;s:4:"type";N;s:10:"isVariadic";b:0;s:5:"byRef";b:0;s:10:"isPromoted";b:0;s:10:"docComment";N;s:10:"attributes";a:0:{}s:9:"startLine";i:1331;s:7:"endLine";i:1331;s:11:"startColumn";i:47;s:9:"endColumn";i:51;s:14:"parameterIndex";i:0;s:10:"isOptional";b:0;}s:8:"callback";a:14:{s:4:"name";s:8:"callback";s:7:"default";N;s:4:"type";N;s:10:"isVariadic";b:0;s:5:"byRef";b:0;s:10:"isPromoted";b:0;s:10:"docComment";N;s:10:"attributes";a:0:{}s:9:"startLine";i:1331;s:7:"endLine";i:1331;s:11:"startColumn";i:54;s:9:"endColumn";i:62;s:14:"parameterIndex";i:1;s:10:"isOptional";b:0;}}s:16:"returnsReference";b:0;s:10:"returnType";N;s:10:"attributes";a:1:{i:0;a:3:{s:4:"name";s:29:"JetBrains\PhpStorm\Deprecated";s:10:"isRepeated";b:0;s:9:"arguments";a:3:{i:0;a:2:{s:4:"code";s:41:"'use Pdo\Sqlite::createCollation instead'";s:10:"attributes";a:6:{s:9:"startLine";i:1330;s:7:"endLine";i:1330;s:13:"startTokenPos";i:3429;s:12:"startFilePos";i:61993;s:11:"endTokenPos";i:3429;s:10:"endFilePos";i:62033;}}i:1;a:2:{s:4:"code";s:48:"'\Pdo\Sqlite::createCollation(%parametersList%)'";s:10:"attributes";a:6:{s:9:"startLine";i:1330;s:7:"endLine";i:1330;s:13:"startTokenPos";i:3432;s:12:"startFilePos";i:62036;s:11:"endTokenPos";i:3432;s:10:"endFilePos";i:62083;}}s:5:"since";a:2:{s:4:"code";s:5:"'8.5'";s:10:"attributes";a:6:{s:9:"startLine";i:1330;s:7:"endLine";i:1330;s:13:"startTokenPos";i:3438;s:12:"startFilePos";i:62093;s:11:"endTokenPos";i:3438;s:10:"endFilePos";i:62097;}}}}}s:10:"docComment";s:704:"/**
 * (PHP 5 &gt;= 5.3.11, PHP 7)<br/>
 * Registers a User Defined Function for use as a collating function in SQL statements
 * @link https://php.net/manual/en/pdo.sqlitecreatecollation.php
 * @param string $name <p>
 * Name of the SQL collating function to be created or redefined.
 * </p>
 * @param callable $callback <p>
 * The name of a PHP function or user-defined function to apply as a callback, defining the behavior of the collation. It should accept two strings and return as strcmp() does, i.e. it should return -1, 1, or 0 if the first string sorts before, sorts after, or is equal to the second.
 * </p>
